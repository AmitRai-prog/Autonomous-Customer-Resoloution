# Multi-Agent Autonomous Customer Resolution System Environment Config

# AI Model Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=company-policies

# Email Configuration (IMAP for intake, SMTP for outbound replies)
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=support@example.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM_NAME="Tech Zephyr Support"

# Execution Mode (Set to true to use deterministic offline simulation for hackathon demo without API keys)
SIMULATED_AI=false

# Database Configuration (SQLite by default, compatible with PostgreSQL)
DATABASE_PATH=./data/customer_resolution.db
